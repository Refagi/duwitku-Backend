{
  "name": "hono",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run format:check",
    "prepare": "husky",
    "pretest": "docker compose -f docker-compose.test.yml up -d --wait",
    "test": "bun test --env-file=.env.test tests",
    "posttest": "docker compose -f docker-compose.test.yml down -v"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.8.7",
    "@logtape/hono": "^2.3.0",
    "@logtape/logtape": "^2.3.0",
    "@logtape/pretty": "^2.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "dayjs": "^1.11.21",
    "hono": "^4.12.34",
    "hono-rate-limiter": "^0.5.3",
    "pg": "^8.22.0",
    "stoker": "^2.0.1",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.20.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
